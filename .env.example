# Candle Obsession: environment variables
#
# Copy to .env for `docker run --env-file .env`, or type these into your host's dashboard
# (Render: Service -> Environment). NEVER commit a real .env file (it is in .gitignore).
#
# Every value here overrides the same setting in appsettings.json. A double underscore (__)
# means "one level down", so Shop__BaseUrl = "Shop": { "BaseUrl": ... }.
# Anything you leave out keeps the value from appsettings.json. Lines starting with "# Key="
# are optional: remove the "# " to use them (an empty value would overwrite appsettings.json).

# ---- Runtime --------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# The container listens on 8080 (already set in the Dockerfile).
ASPNETCORE_HTTP_PORTS=8080
# Render only: tells Render which port the container listens on. The app itself ignores it.
PORT=8080

# ---- Database -------------------------------------------------------------------------
# SQLite file on the persistent disk. Data-protection keys (admin login, form tokens) are
# stored next to it automatically, in /data/keys. Already set in the Dockerfile.
ConnectionStrings__DefaultConnection=Data Source=/data/candleobsession.db

# ---- Shop details ---------------------------------------------------------------------
# Public address of the shop, no trailing slash. Used for canonical links, sitemap.xml,
# Open Graph tags and the payment return URLs (/order/success/..., /order/cancelled/...).
Shop__BaseUrl=https://candleobsession.example
# Where new-order and payment emails are sent (the owner's inbox). Empty = no emails;
# orders are still saved and visible at /admin.
Shop__OrderNotificationEmail=owner@example.com
# Shown on the Contact page and legal pages.
Shop__ContactEmail=hello@example.com
# Shop__ContactPhone=
# Legal details for the legal pages (TODO owner: fill in before launch).
# Shop__LegalName=
# Shop__TradingAddress=
# Shop__RegistrationNumber=
# Shop__VatNumber=
# VAT wording: leave commented out (= not decided, no VAT text shown), true = "Prices include VAT",
# false = "VAT not charged". Confirm with an accountant.
# Shop__PricesIncludeVat=
# Gift wrap price in EUR (empty/null = not decided yet; 0 = free on purpose). TODO owner: set the real price.
# Shop__GiftWrap__PriceEur=0

# ---- Checkout / payments --------------------------------------------------------------
# Manual | PaymentLinks | StripeCheckout   (see INTEGRATION.md)
# Manual = no online payment yet; the order is saved and you send a payment link by hand.
Checkout__Provider=Manual
# true = show a "Buy now" button (straight to the product's payment link) on product pages.
Checkout__ShowBuyNowButtons=false
# PaymentLinks only: link used when a cart can't be paid with a single product link
# (several items, delivery or gift-wrap charges). Empty = fall back to Manual.
# Checkout__PaymentLinks__FallbackUrl=
# StripeCheckout: secret key from Stripe -> Developers -> API keys (sk_test_... while testing).
Checkout__Stripe__SecretKey=sk_test_replace_me
# Signing secret of the webhook pointing at https://YOUR-DOMAIN/api/payments/stripe/webhook
# (whsec_...). Also marks Stripe Payment Link orders as paid. Empty = webhook switched off.
Checkout__Stripe__WebhookSecret=whsec_replace_me

# ---- Admin ----------------------------------------------------------------------------
# Password for https://YOUR-DOMAIN/admin. Empty = admin pages switched off.
# Use a long, unique password (for example 4+ random words).
Admin__Password=replace-with-a-long-unique-password

# ---- Email (SMTP) ---------------------------------------------------------------------
# Your email provider's SMTP details. Leave Smtp__Host empty to switch email off.
Smtp__Host=smtp.example.com
# 587 is standard. Render's FREE plan blocks ports 25, 465 and 587: use 2525 there if your
# provider offers it. Paid Render instances can use 587.
Smtp__Port=587
# true = use TLS (STARTTLS). Keep true unless your provider says otherwise.
Smtp__EnableSsl=true
Smtp__User=smtp-username
Smtp__Password=smtp-password
# Sender address, e.g. "Candle Obsession <orders@example.com>" or just orders@example.com.
Smtp__From=orders@example.com
