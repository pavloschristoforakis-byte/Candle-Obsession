{
  "name": "candle-obsession-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Front-end islands and effects for the Candle Obsession Razor Pages site. Builds into ../wwwroot/dist.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/process-images.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:admin": "node scripts/admin-e2e.mjs"
  },
  "dependencies": {
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-static": "^1.78.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
