# Keep the Docker build context small and free of local data/secrets.

# .NET build output
**/bin/
**/obj/
.vs/
*.user

# Front-end: dependencies and build output are recreated inside the image
**/node_modules/
wwwroot/dist/
ClientApp/screenshots/
ClientApp/test-results/
ClientApp/assets-src/

# Local database, orders and keys (never ship customer data in an image)
App_Data/
*.db
*.db-shm
*.db-wal

# Git and editor files
.git/
.gitignore
.vscode/
.idea/

# Secrets and local settings
.env
.env.*
!.env.example
appsettings.*.local.json

# Deployment/docs files the image doesn't need
Dockerfile
.dockerignore
render.yaml
