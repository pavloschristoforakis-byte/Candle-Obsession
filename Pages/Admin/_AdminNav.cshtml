@model string
@* Tabs shared by the admin pages. Model = the current tab ("orders" or "products"). *@
<nav class="admin-nav" aria-label="Admin sections">
    <a href="/admin" class="chip@(Model == "orders" ? " is-active" : "")" aria-current="@(Model == "orders" ? "page" : null)">Orders</a>
    <a href="/admin/products" class="chip@(Model == "products" ? " is-active" : "")" aria-current="@(Model == "products" ? "page" : null)">Products</a>
</nav>
