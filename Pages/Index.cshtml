@page
@model IndexModel

@{
    ViewData["Title"] = "Candle Obsession";
}

<section class="hero" id="home">

    <div class="hero-content">

        <p class="subtitle">HANDMADE WITH LOVE</p>

        <h1>Light up your moments.</h1>

        <p>Discover the beauty of handmade candles.</p>

        <a href="#collection" class="hero-button">
            EXPLORE COLLECTION
        </a>

    </div>

</section>

<section class="collection" id="collection">

    <p class="subtitle">DISCOVER OUR PRODUCTS</p>

    <h2>Our Collection</h2>

    <div class="product-grid">

        <div class="product-card">
            <img src="/images/candle1.jpg" alt="Macademia Vanilla">
            <h3>Macademia Vanilla</h3>
            <p>€13.00</p>
            <button class="cart-button" onclick="addToCart('Macademia Vanilla', 13)">
                Add to Cart
            </button>
        </div>

        <div class="product-card">
            <img src="/images/candle2.jpg" alt="Baby Powder">
            <h3>Baby Powder</h3>
            <p>€15.00</p>
            <button class="cart-button" onclick="addToCart('Baby Powder', 15)">
                Add to Cart
            </button>
        </div>

        <div class="product-card">
            <img src="/images/candle3.jpg" alt="Apple Pie">
            <h3>Apple Pie</h3>
            <p>€12.00</p>
            <button class="cart-button" onclick="addToCart('Apple Pie', 12)">
                Add to Cart
            </button>
        </div>
        
        <div class="product-card">
            <img src="/images/candle4.jpg" alt="Strawbery">
            <h3>Strawbery</h3>
            <p>€15.00</p>
            <button class="cart-button" onclick="addToCart('Strawbery', 15)">
                Add to Cart
            </button>
        </div>


    </div>

</section>
