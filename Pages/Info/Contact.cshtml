@page "/contact"
@inject Microsoft.Extensions.Options.IOptions<Candle_Obsession.Services.ShopOptions> ShopOpts
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Get in touch with Candle Obsession about orders, custom candles, favours and gifts by email, phone or Instagram.";

    var shop = ShopOpts.Value;
}
<article class="info-page">
    <header class="info-hero">
        <p class="eyebrow">CUSTOMER CARE</p>
        <h1>Contact us</h1>
        <p class="info-updated">Last updated: <mark>[TODO: date]</mark></p>
    </header>
    <partial name="_DraftNotice" />
    <div class="prose">
        <section>
            <h2>Say hello</h2>
            <p>Questions about an order, a custom scent, wedding or christening favours, or a gift idea? We would love to hear from you.</p>
            <dl>
                <dt>Email</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(shop.ContactEmail))
                    {
                        <a href="mailto:@shop.ContactEmail">@shop.ContactEmail</a>
                    }
                    else
                    {
                        @Or(null, "contact email")
                    }
                </dd>
                <dt>Phone</dt>
                <dd>
                    @if (!string.IsNullOrWhiteSpace(shop.ContactPhone))
                    {
                        <a href="tel:@(shop.ContactPhone.Replace(" ", ""))">@shop.ContactPhone</a>
                    }
                    else
                    {
                        @Or(null, "contact phone")
                    }
                </dd>
                <dt>Instagram</dt>
                <dd><a href="@shop.InstagramUrl">@shop.InstagramHandle</a>: send us a direct message (DM).</dd>
            </dl>
            <p>We usually reply within <mark>[TODO: expected reply time, e.g. 1–2 working days]</mark>.</p>
            <p>If you are writing about an order, please include your order number.</p>
        </section>

        <section>
            <h2>Before you write</h2>
            <ul>
                <li>Delivery options, prices and times: <a href="/shipping">Shipping &amp; Delivery</a></li>
                <li>Cancelling, returns and faulty items: <a href="/returns">Returns &amp; Refunds</a></li>
                <li>How to burn your candle safely: <a href="/candle-care">Candle Care &amp; Safety</a></li>
                <li>Ready to treat yourself? <a href="/shop">Visit the shop</a></li>
            </ul>
        </section>

        <section>
            <h2>Business details</h2>
            <dl>
                <dt>Trading name</dt>
                <dd>@shop.Name</dd>
                <dt>Legal name</dt>
                <dd>@Or(shop.LegalName, "legal name of the business owner or company")</dd>
                <dt>Address</dt>
                <dd><address>@Or(shop.TradingAddress, "geographical business address")</address></dd>
                <dt>Registration no.</dt>
                <dd>@Or(shop.RegistrationNumber, "registration number")</dd>
                <dt>VAT no.</dt>
                <dd>@Or(shop.VatNumber, "VAT number, or remove if not VAT-registered")</dd>
            </dl>
            <p>See also our <a href="/terms">Terms of Sale</a> and <a href="/privacy">Privacy Policy</a>.</p>
        </section>
    </div>
</article>

@functions {
    private static Microsoft.AspNetCore.Html.IHtmlContent Or(string? value, string todo) =>
        string.IsNullOrWhiteSpace(value)
            ? new Microsoft.AspNetCore.Html.HtmlString("<mark>[TODO: " + System.Net.WebUtility.HtmlEncode(todo) + "]</mark>")
            : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(value));
}
