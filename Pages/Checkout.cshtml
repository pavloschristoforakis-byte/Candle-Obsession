@page
@model Candle_Obsession.Pages.CheckoutModel
@inject Candle_Obsession.Services.Checkout.CheckoutService Checkout
@{
    ViewData["Title"] = "Checkout";
    ViewData["NoIndex"] = true;
    ViewData["PageClass"] = "page-checkout";
    var shop = Model.Shop;
    var deliveries = shop.DeliveryMethods.Where(d => d.IsAvailable).ToList();
    var payments = shop.PaymentMethods.Where(p => p.Enabled).ToList();
    var countries = deliveries.Where(d => d.Requires == "address").SelectMany(d => d.EffectiveCountries).Distinct().ToList();
    string Price(decimal value) => value == 0 ? "Free" : Money.Eur(value);
    string Inv(decimal value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<section class="checkout-section" aria-labelledby="checkout-title">
    <header class="section-head">
        <p class="eyebrow">Complete your purchase</p>
        <h1 id="checkout-title">Checkout</h1>
    </header>

    <div class="checkout-empty" data-checkout-empty hidden>
        <p data-checkout-empty-text>Your cart is empty.</p>
        <a class="button" href="/shop" data-checkout-empty-link>Continue shopping</a>
    </div>

    <div class="checkout-grid" data-checkout
         data-provider="@Checkout.ActiveProvider"
         data-gift-wrap-price="@Inv(shop.GiftWrap.ChargeEur)"
         data-gift-wrap-confirmed="@(shop.GiftWrap.PriceConfirmed ? "true" : "false")"
         data-min-age="@shop.AlcoholMinimumAge">

        <form id="checkout-form" class="customer-details" novalidate>
            @Html.AntiForgeryToken()

            <fieldset class="form-section">
                <legend><span class="step">1</span> Your details</legend>
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName">First name</label>
                        <input id="firstName" type="text" name="firstName" autocomplete="given-name" maxlength="80" required>
                    </div>
                    <div class="form-group">
                        <label for="lastName">Last name</label>
                        <input id="lastName" type="text" name="lastName" autocomplete="family-name" maxlength="80" required>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="email">Email address</label>
                        <input id="email" type="email" name="email" autocomplete="email" maxlength="254" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone number</label>
                        <input id="phone" type="tel" name="phone" autocomplete="tel" maxlength="30" required>
                    </div>
                </div>
            </fieldset>

            <fieldset class="form-section">
                <legend><span class="step">2</span> Delivery</legend>
                <div class="choice-list">
                    @for (var i = 0; i < deliveries.Count; i++)
                    {
                        var d = deliveries[i];
                        <label class="choice">
                            <input type="radio" name="deliveryMethod" value="@d.Id" checked="@(i == 0)"
                                   data-price="@Inv(d.PriceEur!.Value)" data-requires="@d.Requires"
                                   data-disallow="@string.Join(",", d.DisallowedPaymentMethods)"
                                   data-countries="@string.Join("|", d.EffectiveCountries)">
                            <svg class="icon choice-icon" aria-hidden="true"><use href="#i-@d.Icon"></use></svg>
                            <span class="choice-info">
                                <strong>@d.Name</strong>
                                <small>@d.Description</small>
                            </span>
                            <strong class="choice-price">@Price(d.PriceEur!.Value)</strong>
                        </label>
                    }
                </div>

                <div class="delivery-fields" data-requires-group="address">
                    <div class="form-group">
                        <label for="address">Street address</label>
                        <input id="address" type="text" name="address" autocomplete="street-address" maxlength="200">
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="city">City</label>
                            <input id="city" type="text" name="city" autocomplete="address-level2" maxlength="80">
                        </div>
                        <div class="form-group">
                            <label for="postalCode">Postal code</label>
                            <input id="postalCode" type="text" name="postalCode" autocomplete="postal-code" maxlength="20">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="country">Country</label>
                        <select id="country" name="country" autocomplete="country-name">
                            @foreach (var c in countries)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="delivery-fields" data-requires-group="locker" hidden>
                    <p class="notice">
                        <svg class="icon" aria-hidden="true"><use href="#i-pin"></use></svg>
                        <span>Choose your preferred BOX NOW locker. Cash payment isn't available for lockers.</span>
                    </p>
                    <div class="form-group">
                        <label for="locker">Preferred locker</label>
                        <input id="locker" type="text" name="locker" placeholder="Locker name or location" maxlength="120">
                    </div>
                </div>

                <div class="delivery-fields" data-requires-group="none" hidden>
                    <p class="notice">
                        <svg class="icon" aria-hidden="true"><use href="#i-store"></use></svg>
                        <span>We'll message you after your order to arrange a pickup time and place in Cyprus.</span>
                    </p>
                </div>
            </fieldset>

            @if (shop.GiftWrap.Enabled)
            {
                <fieldset class="form-section gift-options">
                    <legend><span class="step">3</span> Gift this</legend>
                    <label class="toggle">
                        <input type="checkbox" name="giftWrap" value="true" data-gift-wrap>
                        <span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
                        <span>
                            <strong>Gift wrap my order</strong>
                            @if (shop.GiftWrap.PriceConfirmed)
                            {
                                <small>@(shop.GiftWrap.PriceEur == 0 ? "Free" : $"+{Money.Eur(shop.GiftWrap.PriceEur!.Value)}")</small>
                            }
                        </span>
                    </label>
                    <div class="form-group">
                        <label for="giftMessage">Gift message (optional)</label>
                        <textarea id="giftMessage" name="giftMessage" rows="3" maxlength="@shop.GiftWrap.MaxMessageLength"
                                  placeholder="We'll include your message with the order" aria-describedby="giftMessage-count"></textarea>
                        <small class="char-count" id="giftMessage-count" data-char-count="giftMessage" aria-live="polite">0 / @shop.GiftWrap.MaxMessageLength</small>
                    </div>
                </fieldset>
            }

            <fieldset class="form-section">
                <legend><span class="step">@(shop.GiftWrap.Enabled ? 4 : 3)</span> Payment</legend>
                <div class="choice-list">
                    @for (var i = 0; i < payments.Count; i++)
                    {
                        var pm = payments[i];
                        <label class="choice" data-payment-choice="@pm.Id">
                            <input type="radio" name="paymentMethod" value="@pm.Id" checked="@(i == 0)">
                            <svg class="icon choice-icon" aria-hidden="true"><use href="#i-@pm.Icon"></use></svg>
                            <span class="choice-info">
                                <strong>@pm.Name</strong>
                                <small>@pm.Description</small>
                            </span>
                        </label>
                    }
                </div>
                <p class="notice notice-muted" data-card-note>
                    <svg class="icon" aria-hidden="true"><use href="#i-lock"></use></svg>
                    <span>
                        @if (Checkout.ActiveProvider == "Manual")
                        {
                            <text>Online card payment is being set up. After you place your order we'll send you a secure payment link.</text>
                        }
                        else
                        {
                            <text>You'll be taken to our secure payment partner to pay. We never see or store your card details.</text>
                        }
                    </span>
                </p>
            </fieldset>

            <div class="form-group">
                <label for="notes">Order notes (optional)</label>
                <textarea id="notes" name="notes" rows="3" maxlength="1000" placeholder="Special instructions for your order…"></textarea>
            </div>

            <label class="check" data-age-confirm hidden>
                <input type="checkbox" name="ageConfirmed" value="true">
                <span>I confirm I am @shop.AlcoholMinimumAge or older (your order contains wine).</span>
            </label>

            <label class="check">
                <input type="checkbox" name="acceptTerms" value="true" required>
                <span>I agree to the <a href="/terms" target="_blank">Terms of Sale</a> and have read the <a href="/privacy" target="_blank">Privacy Policy</a> and my <a href="/returns" target="_blank">right of withdrawal</a>.</span>
            </label>
        </form>

        <aside class="order-summary" aria-labelledby="summary-title">
            <h2 id="summary-title">Order summary</h2>
            <ul class="summary-items" id="checkout-items" aria-live="polite"></ul>
            <dl class="summary-totals">
                <div><dt>Subtotal</dt><dd data-total="subtotal">€0.00</dd></div>
                <div><dt>Delivery</dt><dd data-total="shipping">€0.00</dd></div>
                <div data-total-row="giftwrap" hidden><dt>Gift wrap</dt><dd data-total="giftwrap">€0.00</dd></div>
                <div class="summary-final"><dt>Total</dt><dd data-total="total">€0.00</dd></div>
            </dl>
            @if (shop.PricesIncludeVat == true)
            {
                <p class="summary-vat">Prices include VAT.</p>
            }
            <button type="submit" form="checkout-form" class="button button-large button-block place-order-button" data-place-order>
                <svg class="icon" aria-hidden="true"><use href="#i-lock"></use></svg>
                <span>Place order</span>
            </button>
            <p class="form-message" id="checkout-message" role="alert"></p>
            <a href="/cart" class="text-link">Back to cart</a>
        </aside>
    </div>
    <noscript><p class="notice">Checkout needs JavaScript. You can also order by messaging us on Instagram.</p></noscript>
</section>
