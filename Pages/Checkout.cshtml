@page
@model Candle_Obsession.Pages.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<section class="checkout-section">

    <p class="subtitle">COMPLETE YOUR PURCHASE</p>

    <h1>Checkout</h1>

    <div class="checkout-grid">

        <div class="customer-details">

            <h2>Customer Details</h2> 

            <form id="checkout-form">

                @Html.AntiForgeryToken()

                <div class="form-row">

                    <div class="form-group">
                        <label>First Name</label>
                        <input type="text" name="firstName" required>
                    </div>

                    <div class="form-group">
                        <label>Last Name</label>
                        <input type="text" name="lastName" required>
                    </div>

                </div>

                <div class="form-group">
                    <label>Email Address</label>
                    <input type="email" name="email" required>
                </div>

                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" name="phone" required>
                </div>
                
                <h2>Delivery Method</h2>

                <div class="delivery-options">

                    <label class="delivery-option">

                        <input type="radio"
                               name="deliveryMethod"
                               value="acs"
                               onchange="updateShipping()"
                               checked>

                        <i data-lucide="truck" class="delivery-icon"></i>

                        <span class="delivery-info">
                            <strong>ACS Courier</strong>
                            <small>Delivery to your address</small>
                        </span>

                        <strong>€5.00</strong>

                    </label>

                    <label class="delivery-option">

                        <input type="radio"
                               name="deliveryMethod"
                               value="boxnow"
                               onchange="updateShipping()">

                        <i data-lucide="package" class="delivery-icon"></i>

                        <span class="delivery-info">
                            <strong>BOX NOW</strong>
                            <small>Collection from a parcel locker</small>
                        </span>

                        <strong>€3.00</strong>

                    </label>

                </div>

                
                <!-- ACS DELIVERY DETAILS -->

                <div id="acs-details">

                    <h2>Delivery Address</h2>

                    <div class="form-group">
                        <label>Street Address</label>
                        <input type="text" name="address" required>
                    </div>

                    <div class="form-row">

                        <div class="form-group">
                            <label>City</label>
                            <input type="text" name="city" required>
                        </div>

                        <div class="form-group">
                            <label>Postal Code</label>
                            <input type="text" name="postalCode" required>
                        </div>

                    </div>

                    <div class="form-group">
                        <label>Country</label>

                        <select name="country">
                            <option value="Cyprus">Cyprus</option>
                        </select>
                    </div>

                </div>

                <!-- BOX NOW DELIVERY DETAILS -->

                <div id="boxnow-details" style="display: none;">

                    <h2>BOX NOW Locker</h2>

                    <div class="locker-information">

                        <i data-lucide="map-pin"></i>

                        <p>Choose your preferred BOX NOW locker.</p>

                    </div>

                    <div class="form-group">
                        <label>Preferred Locker</label>

                        <input type="text"
                               name="locker"
                               placeholder="Enter locker name or location"
                               disabled>
                    </div>

                </div>

                
                <div class="form-group">

                    <label for="order-notes">Order Notes (Optional)</label>

                    <textarea id="order-notes"
                              name="notes"
                              rows="4"
                              placeholder="Special instructions for your order..."></textarea>

                </div>
                
                <!-- PAYMENT METHODS -->

                <h2>Payment Method</h2>

                <div class="payment-options">

                    <label class="payment-option">

                        <input type="radio"
                               name="paymentMethod"
                               value="card"
                               checked>

                        <i data-lucide="credit-card"
                           class="payment-icon"></i>

                        <span class="payment-info">
                            <strong>Credit / Debit Card</strong>
                            <small>Pay securely online</small>
                        </span>

                    </label>

                    <label class="payment-option">

                        <input type="radio"
                               name="paymentMethod"
                               value="revolut">

                        <i data-lucide="smartphone"
                           class="payment-icon"></i>

                        <span class="payment-info">
                            <strong>Revolut</strong>
                            <small>Pay using Revolut</small>
                        </span>

                    </label>

                    <label class="payment-option" id="cash-payment">

                        <input type="radio"
                               name="paymentMethod"
                               value="cash">

                        <i data-lucide="banknote"
                           class="payment-icon"></i>

                        <span class="payment-info">
                            <strong>Cash on Delivery</strong>
                            <small>Pay when receiving your order</small>
                        </span>

                    </label>

                </div>

                
            </form>

        </div>

        <div class="order-summary">

            <h2>Order Summary</h2>

            <div id="checkout-items"></div>

            <div class="order-total">
                <strong>Subtotal</strong>
                <strong>€<span id="checkout-total">0.00</span></strong>
            </div>

            
            <div class="shipping-total">

                <span>Shipping</span>

                <span>€<span id="shipping-cost">5.00</span></span>

            </div>

            <div class="final-total">

                <strong>Total</strong>

                <strong>€<span id="final-total">0.00</span></strong>

            </div>


            <button type="submit"
                    form="checkout-form"
                    class="place-order-button">
                Place Order
            </button>

            <a href="/Cart" class="continue-shopping">
                Back to Cart
            </a>

            <p id="checkout-message"></p>

        </div>

    </div>

</section>
