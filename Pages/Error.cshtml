@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
    ViewData["NoIndex"] = true;
}
<section class="order-result" aria-labelledby="err-title">
    <div class="order-result-card">
        <p class="eyebrow">Error</p>
        <h1 id="err-title">Something went wrong</h1>
        <p class="result-lede">Sorry, the page couldn't be loaded. Please try again in a moment. If you were placing an order, check your email or contact us before ordering again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="result-ref">Reference: <code>@Model.RequestId</code></p>
        }
        <div class="result-actions">
            <a class="button" href="/">Back to home</a>
            <a class="button button-outline" href="/contact">Contact us</a>
        </div>
    </div>
</section>
